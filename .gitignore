# Cargo build output, at any depth: crates/epik-ui is its own workspace and so
# has its own target directory.
target/

# Built by `trunk build` in crates/epik-ui; see crates/epik-app/build.rs.
/crates/epik-app/dist/

# Regenerated by tauri-build on every compile from tauri.conf.json and the
# capability files; committing it just produces diff noise.
/crates/epik-app/gen/schemas/
