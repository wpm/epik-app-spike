{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epik",
  "version": "0.2.0",
  "identifier": "com.epik.app",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Epik",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
